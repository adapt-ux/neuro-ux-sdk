{
  "name": "neuro-js",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/neuro-js/src",
  "projectType": "library",
  "importPath": "@adapt-ux/neuro-js",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/neuro-js",
        "main": "libs/neuro-js/src/index.ts",
        "tsConfig": "libs/neuro-js/tsconfig.lib.json",
        "assets": []
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "{workspaceRoot}/coverage/{projectRoot}"
      }
    }
  }
}
